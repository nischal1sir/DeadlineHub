# Environment variables for Frontend (Vite)
# Copy this file to .env and fill in your actual values.
# When deploying to Vercel/Netlify, set VITE_API_URL to your deployed backend URL.

# Backend Express API base URL
VITE_API_URL=http://localhost:5000/api

# Supabase project URL (found in Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Anonymous/Public Key (found in Supabase Dashboard → Settings → API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
