# Environment variables for Frontend (Vite)
# Copy this file to .env and fill in your actual values.
# When deploying to Vercel/Netlify, set VITE_API_URL to your deployed Render backend URL.

# Backend Express API base URL
VITE_API_URL=http://localhost:5000/api

# Supabase Frontend (public / anon key — safe to expose in the browser)
# Required for: Google OAuth sign-in, self-service password reset
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
